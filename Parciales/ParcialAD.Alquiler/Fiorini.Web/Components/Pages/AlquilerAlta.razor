@page "/alquileres/alta"
@rendermode InteractiveServer
@using Fiorini.Dominio
@using Fiorini.Negocio
@inject AlquilerNegocio Negocio
@inject NavigationManager Navegacion

<PageTitle>Nuevo alquiler</PageTitle>

<h1>Nuevo alquiler</h1>

<p class="text-muted">El alquiler se creará automáticamente con estado <strong>@EstadoAlquiler.Activo</strong>.</p>

@if (errores.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        <ul class="mb-0">
            @foreach (var error in errores)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@* 4.b: el usuario no puede indicar el Estado; lo pre-setea el servicio como "Activo" *@
<EditForm Model="alquiler" OnSubmit="GuardarAsync" FormName="altaAlquiler">
    <div class="row g-3" style="max-width: 520px;">
        <div class="col-12">
            <label class="form-label" for="inquilino">Inquilino</label>
            <InputText id="inquilino" class="form-control" @bind-Value="alquiler.Inquilino" maxlength="100" />
        </div>
        <div class="col-12">
            <label class="form-label" for="monto">Monto alquiler</label>
            <InputNumber id="monto" class="form-control" @bind-Value="alquiler.MontoAlquiler" step="0.01" />
        </div>
        <div class="col-6">
            <label class="form-label" for="fechaInicio">Fecha inicio</label>
            <InputDate id="fechaInicio" class="form-control" @bind-Value="alquiler.FechaInicio" />
        </div>
        <div class="col-6">
            <label class="form-label" for="fechaFin">Fecha fin</label>
            <InputDate id="fechaFin" class="form-control" @bind-Value="alquiler.FechaFin" />
        </div>
        <div class="col-12 d-flex gap-2 justify-content-end">
            <a class="btn btn-outline-secondary" href="alquileres">Cancelar</a>
            <button type="submit" class="btn btn-primary" disabled="@guardando">Aceptar</button>
        </div>
    </div>
</EditForm>

@code {
    private Alquiler alquiler = new()
    {
        FechaInicio = DateTime.Today,
        FechaFin = DateTime.Today.AddYears(1)
    };

    private List<string> errores = new();
    private bool guardando;

    private async Task GuardarAsync()
    {
        // Validación previa en el cliente (la API vuelve a validar del lado del servicio)
        alquiler.Inquilino = alquiler.Inquilino.Trim();
        errores = alquiler.Validar();
        if (errores.Count > 0)
            return;

        guardando = true;
        try
        {
            await Negocio.AgregarAsync(alquiler);
            Navegacion.NavigateTo("alquileres");
        }
        catch (Exception ex)
        {
            errores = new List<string> { ex.Message };
        }
        finally
        {
            guardando = false;
        }
    }
}
